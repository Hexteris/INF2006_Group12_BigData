          {
            "type": "TEXT",
            "data": "+------+----------+--------------------+------------+---------------+\n|ticker|trade_date|future_volatility_5d|future_count|future_end_date|\n+------+----------+--------------------+------------+---------------+\n|ALL   |2013-02-08|0.003730487763284166|5           |2013-02-15     |\n|ALL   |2013-02-11|0.008102123367026487|5           |2013-02-19     |\n|ALL   |2013-02-12|0.010000521204047846|5           |2013-02-20     |\n|ALL   |2013-02-13|0.00993720699497808 |5           |2013-02-21     |\n|ALL   |2013-02-14|0.009897094129212336|5           |2013-02-22     |\n|ALL   |2013-02-15|0.018121199424434915|5           |2013-02-25     |\n|ALL   |2013-02-19|0.014583498165621853|5           |2013-02-26     |\n|ALL   |2013-02-20|0.016060308980440058|5           |2013-02-27     |\n|ALL   |2013-02-21|0.016000676213608046|5           |2013-02-28     |\n|ALL   |2013-02-22|0.01617394752761975 |5           |2013-03-01     |\n+------+----------+--------------------+------------+---------------+\nonly showing top 10 rows\n\n"
          }
        ]
