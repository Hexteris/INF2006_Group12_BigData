    {
      "text": "\n%spark.pyspark\n\n# Calculate the threshold from TRAINING data only\nthreshold = train_vol.approxQuantile(\n    \"future_volatility_5d\",\n    [0.75],\n    0.001\n)[0]\n\nprint(\"High volatility threshold:\", threshold)\n\ndef add_volatility_label(df):\n    return df.withColumn(\n        \"label_volatility_5d\",\n        F.when(\n            F.col(\"future_volatility_5d\") > threshold,\n            F.lit(1.0)\n        ).otherwise(F.lit(0.0))\n    )\n\ntrain_vol = add_volatility_label(train_vol)\nval_vol = add_volatility_label(val_vol)\ntest_vol = add_volatility_label(test_vol)\n\nprint(\"Training labels:\")\ntrain_vol.groupBy(\"label_volatility_5d\").count().show()\n\nprint(\"Validation labels:\")\nval_vol.groupBy(\"label_volatility_5d\").count().show()\n\nprint(\"Testing labels:\")\ntest_vol.groupBy(\"label_volatility_5d\").count().show()\n",
      "user": "anonymous",
      "dateUpdated": "2026-11-13T18:21:08+0000",
