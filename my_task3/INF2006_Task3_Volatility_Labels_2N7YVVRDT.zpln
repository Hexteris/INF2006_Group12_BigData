      "jobName": "paragraph_1794593385480_1642760119",
      "id": "paragraph_1794593385480_1642760119",
      "dateCreated": "2026-11-13T18:09:45+0000",
      "status": "FINISHED",
      "focus": true,
      "$$hashKey": "object:272",
      "text": "\n%spark.pyspark\n\nBUCKET = \"inf2006-g12-ml\"\nBASE = \"s3a://\" + BUCKET\n\n# Existing Task 2 ML data\ntrain = spark.read.parquet(\n    BASE + \"/task2/model_ready_v1/training\"\n)\n\nval = spark.read.parquet(\n    BASE + \"/task2/model_ready_v1/validation\"\n)\n\ntest = spark.read.parquet(\n    BASE + \"/task2/model_ready_v1/testing\"\n)\n\n# Your actual cleaned-price folder\nprices = spark.read.parquet(\n    BASE + \"/task2/cleaned/cleaned/prices\"\n)\n\nprint(\"Training:\", train.count())\nprint(\"Validation:\", val.count())\nprint(\"Testing:\", test.count())\nprint(\"Cleaned prices:\", prices.count())\n\nprices.printSchema()\nprices.show(5, truncate=False)\n",
      "dateUpdated": "2026-11-13T18:19:59+0000",
      "dateFinished": "2026-11-13T18:20:02+0000",
      "dateStarted": "2026-11-13T18:19:59+0000",
      "results": {
        "code": "SUCCESS",
        "msg": [
          {
            "type": "TEXT",
            "data": "Training: 349590\nValidation: 122801\nTesting: 126001\nCleaned prices: 605887\nroot\n |-- ticker: string (nullable = true)\n |-- trade_date: date (nullable = true)\n |-- open_price: double (nullable = true)\n |-- high_price: double (nullable = true)\n |-- low_price: double (nullable = true)\n |-- close_price: double (nullable = true)\n |-- volume: long (nullable = true)\n |-- year: integer (nullable = true)\n\n+------+----------+----------+----------+---------+-----------+-------+----+\n|ticker|trade_date|open_price|high_price|low_price|close_price|volume |year|\n+------+----------+----------+----------+---------+-----------+-------+----+\n|LMT   |2017-02-01|250.83    |252.56    |249.98   |250.9      |1210386|2017|\n|LMT   |2017-02-02|250.9     |252.165   |250.34   |251.97     |1045748|2017|\n|LMT   |2017-02-03|252.67    |256.46    |251.5    |254.46     |1803657|2017|\n|LMT   |2017-02-06|254.43    |257.07    |254.11   |255.31     |980820 |2017|\n|LMT   |2017-02-07|256.0     |257.3     |255.58   |256.37     |977790 |2017|\n+------+----------+----------+----------+---------+-----------+-------+----+\nonly showing top 5 rows\n\n"
          }
        ]
      }
    },
    {
      "text": "\n%spark.pyspark\n\nfrom pyspark.sql import functions as F\nfrom pyspark.sql.window import Window\n\n# Check the columns we need\nrequired = {\"ticker\", \"trade_date\", \"close_price\"}\n\nassert required.issubset(set(prices.columns))\n\n# Prepare cleaned price history\nprices_clean = prices.select(\n    \"ticker\",\n    F.to_date(\"trade_date\").alias(\"trade_date\"),\n    F.col(\"close_price\").cast(\"double\").alias(\"close_price\")\n)\n\n# Check there are no duplicate stock-date records\nduplicates = (\n    prices_clean.groupBy(\"ticker\", \"trade_date\")\n    .count()\n    .filter(F.col(\"count\") > 1)\n    .count()\n)\n\nassert duplicates == 0, \"Duplicate stock-date records found\"\n\n# Sort prices by date for each stock\nw = Window.partitionBy(\"ticker\").orderBy(\"trade_date\")\n\n# Calculate previous closing price\nprices_returns = prices_clean.withColumn(\n    \"previous_close\",\n    F.lag(\"close_price\", 1).over(w)\n)\n\n# Calculate daily return\nprices_returns = prices_returns.withColumn(\n    \"daily_return_future_base\",\n    F.when(\n        F.col(\"previous_close\") > 0,\n        F.col(\"close_price\") / F.col(\"previous_close\") - 1\n    )\n)\n\n# Window covering the NEXT five stock observations\nfuture_window = w.rowsBetween(1, 5)\n\n# Calculate future 5-day volatility\nfuture = (\n    prices_returns\n    .withColumn(\n        \"future_volatility_5d\",\n        F.stddev_samp(\"daily_return_future_base\")\n        .over(future_window)\n    )\n    .withColumn(\n        \"future_count\",\n        F.count(\"daily_return_future_base\")\n        .over(future_window)\n    )\n    .withColumn(\n        \"future_end_date\",\n        F.lead(\"trade_date\", 5).over(w)\n    )\n    .select(\n        \"ticker\",\n        \"trade_date\",\n        \"future_volatility_5d\",\n        \"future_count\",\n        \"future_end_date\"\n    )\n)\n\nfuture.show(10, truncate=False)\n",
      "user": "anonymous",
      "dateUpdated": "2026-11-13T18:20:56+0000",
      "progress": 0,
