    {
      "text": "\n%spark.pyspark\n\n# Keep only rows with five future returns\nvalid_future = future.filter(\n    (F.col(\"future_count\") == 5)\n    & F.col(\"future_volatility_5d\").isNotNull()\n)\n\ndef attach_volatility(df, end_date):\n    prepared = df.withColumn(\n        \"trade_date\",\n        F.to_date(\"trade_date\")\n    )\n\n    result = prepared.join(\n        valid_future,\n        [\"ticker\", \"trade_date\"],\n        \"inner\"\n    )\n\n    # The entire five-session outcome must be\n    # inside the permitted period\n    return result.filter(\n        F.col(\"future_end_date\") <= F.to_date(F.lit(end_date))\n    )\n\ntrain_vol = attach_volatility(train, \"2015-12-31\")\nval_vol = attach_volatility(val, \"2016-12-31\")\ntest_vol = attach_volatility(test, \"2017-12-31\")\n\nprint(\"Training with volatility:\", train_vol.count())\nprint(\"Validation with volatility:\", val_vol.count())\nprint(\"Testing with volatility:\", test_vol.count())\n",
      "user": "anonymous",
      "dateUpdated": "2026-11-13T18:21:02+0000",
