    {
      "text": "\n%spark.pyspark\n\nBUCKET = \"inf2006-g12-ml\"\n\nOUTPUT = f\"s3a://{BUCKET}/task3/volatility_v1\"\n\n# Save datasets\ntrain_vol.write.mode(\"overwrite\").parquet(\n    OUTPUT + \"/training\"\n)\n\nval_vol.write.mode(\"overwrite\").parquet(\n    OUTPUT + \"/validation\"\n)\n\ntest_vol.write.mode(\"overwrite\").parquet(\n    OUTPUT + \"/testing\"\n)\n\n# Save the threshold\nmetadata = spark.createDataFrame(\n    [(float(threshold),)],\n    [\"high_volatility_threshold\"]\n)\n\nmetadata.write.mode(\"overwrite\").json(\n    OUTPUT + \"/metadata\"\n)\n\n# Check saved records\nfor name in [\"training\", \"validation\", \"testing\"]:\n    df = spark.read.parquet(OUTPUT + \"/\" + name)\n    print(name, df.count())\n\nprint(\"SAVED SUCCESSFULLY\")\nprint(\"Location:\", OUTPUT)\n",
