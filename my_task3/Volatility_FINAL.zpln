      "text": "%spark.pyspark\n\nreloaded_model = PipelineModel.load(MODEL_PATH)\n# Compare five example rows before/after reload. Reusing the same untouched inputs.\nsample = data[\"testing\"].orderBy(\"ticker\", \"trade_date\").limit(5).cache()\noriginal = (with_cutoff(final_model.transform(sample)\n    .withColumn(\"risk_score\", vector_to_array(\"probability\")[1]), chosen_threshold)\n    .select(\"ticker\", \"trade_date\", \"prediction\", \"risk_score\"))\nreloaded = (with_cutoff(reloaded_model.transform(sample)\n    .withColumn(\"risk_score\", vector_to_array(\"probability\")[1]), chosen_threshold)\n    .select(\"ticker\", \"trade_date\", \"prediction\", \"risk_score\"))\na = original.orderBy(\"ticker\", \"trade_date\").collect()\nb = reloaded.orderBy(\"ticker\", \"trade_date\").collect()\nassert len(a) == len(b) == 5, \"Expected five examples\"\nfor before, after in zip(a, b):\n    assert before[\"ticker\"] == after[\"ticker\"] and before[\"trade_date\"] == after[\"trade_date\"]\n    assert before[\"prediction\"] == after[\"prediction\"]\n    assert abs(before[\"risk_score\"] - after[\"risk_score\"]) < 1e-9\nprint(\"RELOAD CHECK PASSED — same predictions and probability scores on five rows.\")\nreloaded.show(5, truncate=False)\nsample.unpersist()\n",
