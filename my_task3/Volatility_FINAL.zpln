    {
      "title": "Train and select",
      "text": "%spark.pyspark\n# Train several CANDIDATES on training data; compare using 2016 validation.\n# Logistic regression gets scaled data; tree models use unscaled data (faster).\ndef pipeline_for(kind, cols):\n    imputed = [c + \"_filled\" for c in cols]\n    steps = [Imputer(inputCols=cols, outputCols=imputed, strategy=\"median\")]\n    if kind == \"lr\":\n        steps += [VectorAssembler(inputCols=imputed, outputCol=\"unscaled\"),\n                  StandardScaler(inputCol=\"unscaled\", outputCol=\"features\", withStd=True, withMean=False),\n                  LogisticRegression(featuresCol=\"features\", labelCol=\"target\", maxIter=100, regParam=0.01)]\n    elif kind == \"gbt\":\n        steps += [VectorAssembler(inputCols=imputed, outputCol=\"features\"),\n                  GBTClassifier(featuresCol=\"features\", labelCol=\"target\", maxIter=35, maxDepth=4,\n                                minInstancesPerNode=30, seed=SEED)]\n    elif kind == \"rf\":\n        steps += [VectorAssembler(inputCols=imputed, outputCol=\"features\"),\n                  RandomForestClassifier(featuresCol=\"features\", labelCol=\"target\", numTrees=50,\n                                         maxDepth=7, minInstancesPerNode=30, seed=SEED)]\n    return Pipeline(stages=steps)\n\ncandidates = [(\"logistic_base\", \"lr\", BASE_FEATURES),\n              (\"logistic_extra\", \"lr\", ALL_FEATURES),\n              (\"gbt_extra\", \"gbt\", ALL_FEATURES)]\nif TRY_RANDOM_FOREST:\n    candidates.append((\"random_forest_extra\", \"rf\", ALL_FEATURES))\nresults = []\nfitted = {}\nfor name, kind, cols in candidates:\n    start = time.time()\n    print(\"\\nTRAINING:\", name, \"with\", len(cols), \"features\", flush=True)\n    fitted[name] = pipeline_for(kind, cols).fit(data[\"training\"])\n    scores = (fitted[name].transform(data[\"validation\"])\n        .withColumn(\"risk_score\", vector_to_array(\"probability\")[1]).select(\"target\", \"risk_score\").cache())\n    scores.count()  # materialize cache once, then reuse for threshold + evaluation\n    threshold = find_threshold(scores)\n    comparison = measure(with_cutoff(scores, threshold), name + \"_validation\")\n    comparison.update(name=name, threshold=threshold, feature_count=len(cols),\n                      fit_seconds=round(time.time() - start, 1))\n    results.append(comparison)\n    scores.unpersist()\n    print(\"Threshold selected on VALIDATION:\", threshold)\n# Prioritize ranking quality (AUC); balanced accuracy breaks ties.\n# The threshold is separately tuned to make decisions about class 0 versus class 1.\nchosen = sorted(results, key=lambda x: (-x[\"auc\"], -x[\"balanced_accuracy\"], x[\"name\"]))[0]\nchosen_name = chosen[\"name\"]\nchosen_threshold = chosen[\"threshold\"]\nfinal_model = fitted[chosen_name]\nchosen_features = next(cols for name, kind, cols in candidates if name == chosen_name)\nprint(\"\\nWINNING MODEL:\", chosen_name, \"| validation AUC:\", chosen[\"auc\"],\n      \"| validation balanced accuracy:\", chosen[\"balanced_accuracy\"], \"| decision cutoff:\", chosen_threshold)\nprint(\"Comparison:\")\nfor r in results:\n    print(r[\"name\"], \"AUC\", r[\"auc\"], \"balanced accuracy\", r[\"balanced_accuracy\"],\n          \"F1\", r[\"f1\"], \"threshold\", r[\"threshold\"], \"fit seconds\", r[\"fit_seconds\"])\nprint(\"Test data has NOT been used to choose the model.\")\n",
      "user": "anonymous",
