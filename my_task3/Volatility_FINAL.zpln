    {
      "title": "Final test",
      "text": "%spark.pyspark\n# Final one-time evaluation on unseen 2017 data.\n\ntest_scores = (final_model.transform(data[\"testing\"])\n    .withColumn(\"risk_score\", vector_to_array(\"probability\")[1]))\ntest_predictions = with_cutoff(test_scores, chosen_threshold).cache()\ntest_predictions.count()\nfinal_test = measure(test_predictions, chosen_name + \"_FINAL_TEST\")\ntest_baselines = evaluate_baselines(data[\"testing\"], \"testing\")\nprint(\"\\nCONFUSION MATRIX (actual rows, predicted columns):\")\nprint(\"             predict 0   predict 1\")\nprint(\"actual 0    {:>10} {:>10}\".format(final_test[\"tn\"], final_test[\"fp\"]))\nprint(\"actual 1    {:>10} {:>10}\".format(final_test[\"fn\"], final_test[\"tp\"]))\nprint(\"Compare balanced accuracy and AUC against the baselines, not accuracy alone.\")\n",
