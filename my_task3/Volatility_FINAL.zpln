    {
      "title": "Understand features",
      "text": "%spark.pyspark\n# Bigger tree importance = this feature influenced splits more. Not proof of causation.\n# Logistic coefficients refer to standardized features (sign tells direction of association).\nmodel_stage = final_model.stages[-1]\nif hasattr(model_stage, \"coefficients\"):\n    weights = model_stage.coefficients.toArray()\n    meaning = \"standardized logistic coefficient\"\nelse:\n    weights = model_stage.featureImportances.toArray()\n    meaning = \"tree feature importance\"\nprint(\"Chosen algorithm:\", chosen_name, \"|\", meaning)\nfor col, weight in sorted(zip(chosen_features, weights), key=lambda pair: -abs(pair[1])):\n    print(\"{:<26s} {: .5f}\".format(col, float(weight)))\nprint(\"WARNING: feature importance is not proof of prediction reliability or causality.\")\n",
