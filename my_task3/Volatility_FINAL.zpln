    {
      "title": "Calculate past-only features",
      "text": "%spark.pyspark\n# Build extra features using ONLY current and earlier daily prices.\nprices = spark.read.parquet(PRICES_PATH).select(\"ticker\", F.to_date(\"trade_date\").alias(\"trade_date\"),\n    *[F.col(c).cast(\"double\").alias(c) for c in [\"high_price\", \"low_price\", \"close_price\", \"volume\"]])\nassert prices.groupBy(\"ticker\", \"trade_date\").count().filter(\"count > 1\").limit(1).count() == 0, \"Duplicate cleaned prices\"\nw = Window.partitionBy(\"ticker\").orderBy(\"trade_date\")\ndef past(days):\n    return w.rowsBetween(-(days - 1), 0)  # never reads future dates\np = (prices.withColumn(\"prior_close\", F.lag(\"close_price\").over(w))\n    .withColumn(\"ret\", F.when(F.col(\"prior_close\") > 0, F.col(\"close_price\") / F.col(\"prior_close\") - 1))\n    .withColumn(\"rng\", F.when(F.col(\"close_price\") > 0, (F.col(\"high_price\") - F.col(\"low_price\")) / F.col(\"close_price\")))\n    .withColumn(\"logvol\", F.when(F.col(\"volume\") >= 0, F.log1p(\"volume\"))))\np = (p.withColumn(\"volatility_5d\", F.stddev_samp(\"ret\").over(past(5)))\n    .withColumn(\"volatility_60d\", F.stddev_samp(\"ret\").over(past(60)))\n    .withColumn(\"abs_return_5d\", F.avg(F.abs(\"ret\")).over(past(5)))\n    .withColumn(\"range_5d\", F.avg(\"rng\").over(past(5)))\n    .withColumn(\"return_20d\", F.when(F.lag(\"close_price\", 20).over(w) > 0,\n        F.col(\"close_price\") / F.lag(\"close_price\", 20).over(w) - 1))\n    .withColumn(\"volume_z_20d\", F.when(F.stddev_samp(\"logvol\").over(past(20)) > 0,\n        (F.col(\"logvol\") - F.avg(\"logvol\").over(past(20))) / F.stddev_samp(\"logvol\").over(past(20)))))\np = p.withColumn(\"vol_ratio_5_60\", F.when(F.col(\"volatility_60d\") > 0,\n    F.col(\"volatility_5d\") / F.col(\"volatility_60d\")))\nmarket = Window.partitionBy(\"trade_date\")\np = (p.withColumn(\"market_return_1d\", F.avg(\"ret\").over(market))\n      .withColumn(\"market_volatility_5d\", F.avg(\"volatility_5d\").over(market)))\nextra = p.select(\"ticker\", \"trade_date\", *EXTRA_FEATURES)\nfor c in EXTRA_FEATURES:\n    extra = extra.withColumn(c, F.when(F.isnan(c) | (F.abs(F.col(c)) == float(\"inf\")), F.lit(None).cast(\"double\")).otherwise(F.col(c)))\n# Missing *extra* values are handled by an Imputer fitted ONLY on training.\n# Left join deliberately keeps rows that have no matching cleaned-price record.\nfor split in SPLITS:\n    old = data[split]\n    joined = old.join(extra, [\"ticker\", \"trade_date\"], \"left\").cache()\n    assert joined.count() == old.count(), \"Feature join unexpectedly changed the number of rows\"\n    data[split] = joined\n    old.unpersist()\nprint(\"Extra features added:\", EXTRA_FEATURES)\nprint(\"Missing extra features in training (model will fill them from training medians):\")\ndata[\"training\"].select(*[F.sum(F.col(c).isNull().cast(\"int\")).alias(c) for c in EXTRA_FEATURES]).show(vertical=True)\n",
      "user": "anonymous",
