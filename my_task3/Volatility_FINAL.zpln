        "code": "SUCCESS",
        "msg": [
          {
            "type": "TEXT",
            "data": "Extra features added: ['volatility_5d', 'volatility_60d', 'vol_ratio_5_60', 'abs_return_5d', 'range_5d', 'return_20d', 'volume_z_20d', 'market_return_1d', 'market_volatility_5d']\nMissing extra features in training (model will fill them from training medians):\n-RECORD 0--------------------\n volatility_5d        | 0    \n volatility_60d       | 0    \n vol_ratio_5_60       | 0    \n abs_return_5d        | 0    \n range_5d             | 0    \n return_20d           | 7425 \n volume_z_20d         | 0    \n market_return_1d     | 0    \n market_volatility_5d | 0    \n\n"
          }
        ]
      }
    },
    {
      "title": "Metrics and baselines",
      "text": "%spark.pyspark\n# How we judge models\n# Balanced accuracy gives equal importance to detecting 0 and detecting 1.\n# AUC measures how well the probability scores rank positive examples above negative ones.\nauc_evaluator = BinaryClassificationEvaluator(labelCol=\"target\", rawPredictionCol=\"risk_score\", metricName=\"areaUnderROC\")\ndef measure(df, title, use_auc=True):\n    counts = {(int(r[\"target\"]), int(r[\"prediction\"])): r[\"count\"]\n              for r in df.groupBy(\"target\", \"prediction\").count().collect()}\n    tn, fp, fn, tp = [counts.get(key, 0) for key in [(0,0), (0,1), (1,0), (1,1)]]\n    total = tn + fp + fn + tp\n    assert total > 0, \"No data to evaluate\"\n    recall = tp / (tp + fn) if tp + fn else 0.0\n    specificity = tn / (tn + fp) if tn + fp else 0.0\n    precision = tp / (tp + fp) if tp + fp else 0.0\n    f1 = 2 * precision * recall / (precision + recall) if precision + recall else 0.0\n    result = dict(model=title, rows=total, auc=round(float(auc_evaluator.evaluate(df)), 5) if use_auc else None,\n        accuracy=round((tp + tn) / total, 5), balanced_accuracy=round((recall + specificity) / 2, 5),\n        f1=round(f1, 5), recall=round(recall, 5), precision=round(precision, 5),\n        tn=tn, fp=fp, fn=fn, tp=tp)\n    print(title, result)\n    return result\n\n# Faster than evaluating hundreds of full Spark queries: collect only a SMALL score histogram.\n# Search cutoff 0.05–0.95 in steps of 0.01. We choose this on VALIDATION, never on TEST.\ndef find_threshold(df):\n    hist = (df.select(F.least(F.greatest(F.floor(F.col(\"risk_score\") * 100), F.lit(0)), F.lit(100)).cast(\"int\").alias(\"bin\"), \"target\")\n              .groupBy(\"bin\", \"target\").count().collect())\n    positives, negatives = [0] * 101, [0] * 101\n    for r in hist:\n        (positives if float(r[\"target\"]) == 1.0 else negatives)[int(r[\"bin\"])] += r[\"count\"]\n    P, N = sum(positives), sum(negatives)\n    assert P > 0 and N > 0, \"Both classes must appear in validation\"\n    best = (-1.0, None)\n    for k in range(5, 96):\n        tp = sum(positives[k:])   # predict 1 when probability >= k / 100\n        tn = sum(negatives[:k])   # predict 0 otherwise\n        bal = (tp / P + tn / N) / 2\n        if bal > best[0]:\n            best = (bal, k / 100.0)\n    return best[1]\n\ndef with_cutoff(df, threshold):\n    return df.withColumn(\"prediction\", (F.col(\"risk_score\") >= F.lit(float(threshold))).cast(\"double\"))\n\n# Simple rule baselines let us check whether ML actually beats an easy alternative.\nmajority = float(data[\"training\"].groupBy(\"target\").count().orderBy(F.desc(\"count\")).first()[\"target\"])\nrule_col = \"return_5d\" if TASK == \"direction\" else \"volatility_20d\"\nrule_cutoff = 0.0 if TASK == \"direction\" else float(data[\"training\"].approxQuantile(rule_col, [0.75], 0.001)[0])\ndef evaluate_baselines(df, split):\n    m = measure(df.withColumn(\"prediction\", F.lit(majority)).withColumn(\"risk_score\", F.lit(majority)),\n                \"always_majority_\" + split)\n    r = measure(df.withColumn(\"prediction\", (F.col(rule_col) > rule_cutoff).cast(\"double\"))\n                .withColumn(\"risk_score\", F.col(rule_col)), \"historical_rule_\" + split)\n    return [m, r]\nvalidation_baselines = evaluate_baselines(data[\"validation\"], \"validation\")\nprint(\"Rule:\", rule_col, \">\", rule_cutoff)\n",
      "user": "anonymous",
