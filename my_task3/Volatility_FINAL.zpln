    {
      "title": "Save",
      "text": "%spark.pyspark\n# Save the pipeline, predictions and scores in S3.\n# Note: Spark writes folders containing part-files, not one .csv file.\nMODEL_PATH = OUT + \"/model\"\nPRED_PATH = OUT + \"/predictions\"\nMETRICS_PATH = OUT + \"/metrics\"\nSETTINGS_PATH = OUT + \"/settings\"\nfinal_model.write().overwrite().save(MODEL_PATH)\n(test_predictions.select(\"ticker\", \"trade_date\", \"target\", \"prediction\", \"risk_score\")\n    .write.mode(\"overwrite\").parquet(PRED_PATH))\nall_metrics = ([dict(stage=\"validation\", **r) for r in validation_baselines + results] +\n               [dict(stage=\"testing\", **r) for r in test_baselines + [final_test]])\nspark.createDataFrame([(json.dumps(r),) for r in all_metrics], [\"value\"]).coalesce(1).write.mode(\"overwrite\").text(METRICS_PATH)\ninfo = dict(task=TASK, run_id=RUN_ID, algorithm=chosen_name, threshold=chosen_threshold,\n    features=chosen_features, input_path=INPUT, prices_path=PRICES_PATH,\n    model_path=MODEL_PATH, predictions_path=PRED_PATH, validation_auc=chosen[\"auc\"],\n    validation_balanced_accuracy=chosen[\"balanced_accuracy\"])\nspark.createDataFrame([(json.dumps(info),)], [\"value\"]).coalesce(1).write.mode(\"overwrite\").text(SETTINGS_PATH)\nassert spark.read.parquet(PRED_PATH).count() == data[\"testing\"].count()\nprint(\"SAVED. RUN_ID:\", RUN_ID)\nprint(\"MODEL:\", MODEL_PATH)\nprint(\"PREDICTIONS:\", PRED_PATH)\nprint(\"SETTINGS:\", SETTINGS_PATH)\n",
