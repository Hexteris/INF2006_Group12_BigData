            "data": "always_majority_validation {'model': 'always_majority_validation', 'rows': 122801, 'auc': 0.5, 'accuracy': 0.67488, 'balanced_accuracy': 0.5, 'f1': 0.0, 'recall': 0.0, 'precision': 0.0, 'tn': 82876, 'fp': 0, 'fn': 39925, 'tp': 0}\nhistorical_rule_validation {'model': 'historical_rule_validation', 'rows': 122801, 'auc': 0.70313, 'accuracy': 0.68164, 'balanced_accuracy': 0.65597, 'f1': 0.54335, 'recall': 0.58257, 'precision': 0.50908, 'tn': 60447, 'fp': 22429, 'fn': 16666, 'tp': 23259}\nRule: volatility_20d > 0.01606290757433682\n"
