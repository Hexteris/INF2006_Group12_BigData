    {
      "title": "Load and check input",
      "text": "%spark.pyspark\n# Load and check Task 2's existing labels and five original input features.\n# An input feature describes what we know as of TODAY. The label describes the FUTURE.\ndef prepare(df):\n    required = [\"ticker\", \"trade_date\", LABEL] + BASE_FEATURES\n    missing = sorted(set(required) - set(df.columns))\n    assert not missing, \"Missing columns: \" + str(missing)\n    out = df.select(\"ticker\", F.to_date(\"trade_date\").alias(\"trade_date\"),\n        *[F.col(c).cast(\"double\").alias(c) for c in BASE_FEATURES],\n        F.col(LABEL).cast(\"double\").alias(\"target\"))\n    invalid = F.col(\"target\").isNull() | (~F.col(\"target\").isin(0.0, 1.0))\n    for col in BASE_FEATURES:\n        invalid = invalid | F.col(col).isNull() | F.isnan(col) | (F.abs(F.col(col)) == float(\"inf\"))\n    assert out.filter(invalid).limit(1).count() == 0, \"Invalid original features or target\"\n    assert out.groupBy(\"ticker\", \"trade_date\").count().filter(\"count > 1\").limit(1).count() == 0, \"Duplicate ticker/date\"\n    return out\n\ndata = {}\nfor split in SPLITS:\n    data[split] = prepare(spark.read.parquet(INPUT + \"/\" + split)).cache()\n    n = data[split].count()\n    summary = data[split].agg(F.min(\"trade_date\"), F.max(\"trade_date\"), F.avg(\"target\")).first()\n    print(split, \"rows:\", n, \"dates:\", summary[0], \"to\", summary[1], \"positive share:\", round(summary[2], 4))\n# The row counts below were observed in your earlier completed notebooks.\nexpected = ({\"training\":349590, \"validation\":122801, \"testing\":126001} if TASK == \"direction\"\n            else {\"training\":349590, \"validation\":122801, \"testing\":123476})\nfor split in SPLITS:\n    assert data[split].count() == expected[split], \"Unexpected \" + split + \" count; investigate changed upstream data\"\nprint(\"Input data checks passed.\")\n",
      "user": "anonymous",
