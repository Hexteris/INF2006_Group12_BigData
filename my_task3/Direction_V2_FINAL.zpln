      "text": "%spark.pyspark\n# Final 2017 test. Run this after selecting the model from 2016.\n\ntest_scores = (final_model.transform(data[\"testing\"])\n    .withColumn(\"risk_score\", vector_to_array(\"probability\")[1]))\ntest_predictions = with_cutoff(test_scores, chosen_cutoff).cache()\ntest_predictions.count()\nfinal_test = metric(test_predictions, chosen_name + \"_FINAL_TEST_2017\")\nmajority_predictions = (data[\"testing\"]\n    .withColumn(\"risk_score\", F.lit(majority))\n    .withColumn(\"prediction\", F.lit(majority)))\nbaseline_test = metric(majority_predictions, \"always_training_majority_2017\")\nprint(\"\\nCONFUSION MATRIX: actual rows / predicted columns\")\nprint(\"              predicted 0   predicted 1\")\nprint(\"actual 0      {:>10}    {:>10}\".format(final_test[\"tn\"], final_test[\"fp\"]))\nprint(\"actual 1      {:>10}    {:>10}\".format(final_test[\"fn\"], final_test[\"tp\"]))\nprint(\"\\n==== FOUR NUMBERS TO SEND ME ====\")\nprint(\"2016 validation AUC:\", chosen[\"auc\"])\nprint(\"2016 validation balanced accuracy:\", chosen[\"balanced_accuracy\"])\nprint(\"2017 TEST AUC:\", final_test[\"auc\"])\nprint(\"2017 TEST balanced accuracy:\", final_test[\"balanced_accuracy\"])\nprint(\"V1 direction benchmark: test AUC 0.50044, test balanced accuracy 0.49975\")\nprint(\"Reminder: we have already looked at 2017 results in V1. Avoid further tuning on 2017.\")\n",
