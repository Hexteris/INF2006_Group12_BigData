    },
    {
      "title": "Metrics",
      "text": "%spark.pyspark\n#  Metrics and a simple baseline.\n# AUC and balanced accuracy are the two headline numbers for report\nauc_evaluator = BinaryClassificationEvaluator(labelCol=\"target\", rawPredictionCol=\"risk_score\", metricName=\"areaUnderROC\")\ndef with_cutoff(df, cutoff):\n    return df.withColumn(\"prediction\", (F.col(\"risk_score\") >= F.lit(float(cutoff))).cast(\"double\"))\ndef metric(df, title):\n    counts = {(int(r[\"target\"]), int(r[\"prediction\"])): r[\"count\"]\n              for r in df.groupBy(\"target\", \"prediction\").count().collect()}\n    tn, fp, fn, tp = [counts.get(k, 0) for k in [(0,0), (0,1), (1,0), (1,1)]]\n    n = tn + fp + fn + tp\n    sensitivity = tp/(tp+fn) if tp+fn else 0\n    specificity = tn/(tn+fp) if tn+fp else 0\n    precision = tp/(tp+fp) if tp+fp else 0\n    f1 = 2*precision*sensitivity/(precision+sensitivity) if precision+sensitivity else 0\n    result = dict(name=title, n=n, auc=round(auc_evaluator.evaluate(df), 5),\n        balanced_accuracy=round((sensitivity+specificity)/2, 5),\n        accuracy=round((tp+tn)/n, 5), f1=round(f1, 5),\n        recall=round(sensitivity, 5), specificity=round(specificity, 5),\n        tn=tn, fp=fp, fn=fn, tp=tp)\n    print(title, result)\n    return result\n# Search for the decision cutoff using tiny aggregated histogram (not 100 full-data queries).\ndef best_cutoff(scores):\n    hist = (scores.select(F.least(F.greatest(F.floor(F.col(\"risk_score\")*100), F.lit(0)), F.lit(100)).cast(\"int\").alias(\"bin\"), \"target\")\n         .groupBy(\"bin\", \"target\").count().collect())\n    positives, negatives = [0]*101, [0]*101\n    for row in hist:\n        (positives if row[\"target\"] == 1.0 else negatives)[row[\"bin\"]] += row[\"count\"]\n    P, N = sum(positives), sum(negatives)\n    assert P and N\n    best = (-1, 0.5)\n    for k in range(10, 91):\n        tp, tn = sum(positives[k:]), sum(negatives[:k])\n        bal = 0.5*(tp/P+tn/N)\n        if bal > best[0]: best = (bal, k/100.0)\n    return best[1]\nmajority = float(data[\"training\"].groupBy(\"target\").count().orderBy(F.desc(\"count\")).first()[\"target\"])\nprint(\"Training majority class:\", majority)\nprint(\"Chance-level AUC = 0.50, balanced accuracy = 0.50.\")\n",
      "user": "anonymous",
      "dateUpdated": "2026-11-14T18:26:06+0000",
