      "title": "Feature importance",
      "text": "%spark.pyspark\n# Feature importance explains what the model paid attention to.\n# Large absolute logistic weights = stronger association, NOT guaranteed prediction.\nstage = final_model.stages[-1]\nweights = stage.coefficients.toArray() if hasattr(stage, \"coefficients\") else stage.featureImportances.toArray()\nprint(\"Winner:\", chosen_name)\nfor col, weight in sorted(zip(chosen_features, weights), key=lambda x:-abs(x[1])):\n    print(\"{:<28} {: .5f}\".format(col, float(weight)))\n",
