    {
      "title": "Load input",
      "text": "%spark.pyspark\n\ndef prepare(df):\n    required = [\"ticker\", \"trade_date\", \"label\"] + BASE_FEATURES\n    missing = sorted(set(required) - set(df.columns))\n    assert not missing, \"Missing input columns: \" + str(missing)\n    out = df.select(\"ticker\", F.to_date(\"trade_date\").alias(\"trade_date\"),\n         *[F.col(c).cast(\"double\").alias(c) for c in BASE_FEATURES],\n         F.col(\"label\").cast(\"double\").alias(\"target\"))\n    invalid = F.col(\"target\").isNull() | (~F.col(\"target\").isin(0.0, 1.0))\n    for c in BASE_FEATURES:\n        invalid = invalid | F.col(c).isNull() | F.isnan(c) | (F.abs(F.col(c)) == float(\"inf\"))\n    assert out.filter(invalid).limit(1).count() == 0, \"Invalid target or original feature values\"\n    assert out.groupBy(\"ticker\", \"trade_date\").count().filter(\"count > 1\").limit(1).count() == 0, \"Duplicate ticker-date\"\n    return out\n\ndata = {}\nfor split in SPLITS:\n    data[split] = prepare(spark.read.parquet(INPUT + \"/\" + split)).cache()\n    count = data[split].count()\n    summ = data[split].agg(F.min(\"trade_date\"), F.max(\"trade_date\"), F.avg(\"target\")).first()\n    print(split, \"rows\", count, \"dates\", summ[0], \"to\", summ[1], \"rise proportion\", round(summ[2], 4))\nexpected = {\"training\": 349590, \"validation\": 122801, \"testing\": 126001}\nfor split in SPLITS:\n    assert data[split].count() == expected[split], \"Row count changed for \" + split\nprint(\"Input validation passed.\")\n",
