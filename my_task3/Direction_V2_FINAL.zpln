    {
      "title": "Compare models",
      "text": "%spark.pyspark\n# Train\n# We compare stronger regularization and different groups of indicators.\nRUN_GBT = True  # Change to False if tree training is too slow.\n\ndef pipeline_for(kind, cols, strength=0.1):\n    filled = [c+\"_filled\" for c in cols]\n    stages = [Imputer(inputCols=cols, outputCols=filled, strategy=\"median\")]\n    if kind == \"lr\":\n        stages += [VectorAssembler(inputCols=filled, outputCol=\"unscaled\"),\n                   StandardScaler(inputCol=\"unscaled\", outputCol=\"features\", withStd=True, withMean=False),\n                   LogisticRegression(featuresCol=\"features\", labelCol=\"target\", maxIter=120,\n                                      regParam=strength, elasticNetParam=0.0)]\n    else:\n        stages += [VectorAssembler(inputCols=filled, outputCol=\"features\"),\n                   GBTClassifier(featuresCol=\"features\", labelCol=\"target\", maxIter=35,\n                                 maxDepth=3, minInstancesPerNode=60, seed=SEED)]\n    return Pipeline(stages=stages)\n\ncandidates = [\n    (\"logistic_base_r01\", \"lr\", BASE_FEATURES, 0.1),\n    (\"logistic_trend_r01\", \"lr\", TREND_FEATURES, 0.1),\n    (\"logistic_market_r01\", \"lr\", MARKET_FEATURES, 0.1),\n    (\"logistic_market_r10\", \"lr\", MARKET_FEATURES, 1.0),\n    (\"logistic_full_r01\", \"lr\", FULL_FEATURES, 0.1),\n    (\"logistic_full_r10\", \"lr\", FULL_FEATURES, 1.0),\n]\nif RUN_GBT:\n    candidates += [(\"gbt_market\", \"gbt\", MARKET_FEATURES, None)]\n\nfitted, results = {}, []\nfor name, kind, cols, strength in candidates:\n    start = time.time()\n    print(\"\\nTraining\", name, \"with\", len(cols), \"features\", flush=True)\n    model = pipeline_for(kind, cols, strength).fit(data[\"training\"])\n    # We use two periods within 2016 as a stability check: early and late 2016.\n    scores = (model.transform(data[\"validation\"])\n        .withColumn(\"risk_score\", vector_to_array(\"probability\")[1])\n        .select(\"trade_date\", \"target\", \"risk_score\").cache())\n    scores.count()\n    cutoff = best_cutoff(scores)\n    pred = with_cutoff(scores, cutoff)\n    full = metric(pred, name + \"_2016\")\n    early = pred.filter(F.col(\"trade_date\") < F.lit(\"2016-07-01\"))\n    late = pred.filter(F.col(\"trade_date\") >= F.lit(\"2016-07-01\"))\n    auc_early = round(auc_evaluator.evaluate(early), 5)\n    auc_late = round(auc_evaluator.evaluate(late), 5)\n    print(\"2016 AUC: Jan-Jun\", auc_early, \"| Jul-Dec\", auc_late, \"| cutoff\", cutoff)\n    results.append(dict(name=name, auc=full[\"auc\"], balanced_accuracy=full[\"balanced_accuracy\"],\n                        cutoff=cutoff, auc_early=auc_early, auc_late=auc_late,\n                        worst_half_auc=min(auc_early, auc_late), seconds=round(time.time()-start, 1)))\n    fitted[name] = model\n    scores.unpersist()\n# Prefer consistency: highest worst-half AUC first, then overall 2016 AUC.\n# This helps avoid selecting a model that only happened to work in one period.\nchosen = sorted(results, key=lambda r: (-r[\"worst_half_auc\"], -r[\"auc\"], r[\"name\"]))[0]\nchosen_name, chosen_cutoff = chosen[\"name\"], chosen[\"cutoff\"]\nfinal_model = fitted[chosen_name]\nchosen_features = next(cols for name, kind, cols, _ in candidates if name == chosen_name)\nprint(\"\\n================ MODEL SELECTED FROM 2016 ================\")\nfor r in results:\n    print(r[\"name\"], \"AUC\", r[\"auc\"], \"balanced accuracy\", r[\"balanced_accuracy\"],\n          \"worst half AUC\", r[\"worst_half_auc\"], \"seconds\", r[\"seconds\"])\nprint(\"WINNER:\", chosen_name, \"| 2016 AUC\", chosen[\"auc\"],\n      \"| 2016 balanced accuracy\", chosen[\"balanced_accuracy\"],\n      \"| cutoff\", chosen_cutoff)\nprint(\"No 2017 data used to select the winner.\")\n",
      "user": "anonymous",
      "dateUpdated": "2026-11-14T18:26:07+0000",
