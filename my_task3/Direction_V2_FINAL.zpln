    {
      "title": "Create features",
      "text": "%spark.pyspark\n# Build indicators only from past/current trading dates.\n# Example: return_60d compares today's closing price with 60 sessions ago.\n# Example: market_breadth_1d = fraction of stocks that rose today.\nprices = spark.read.parquet(PRICES_PATH).select(\n    \"ticker\", F.to_date(\"trade_date\").alias(\"trade_date\"),\n    *[F.col(c).cast(\"double\").alias(c) for c in [\"high_price\", \"low_price\", \"close_price\", \"volume\"]])\nassert prices.groupBy(\"ticker\", \"trade_date\").count().filter(\"count > 1\").limit(1).count() == 0, \"Duplicate prices\"\nw = Window.partitionBy(\"ticker\").orderBy(\"trade_date\")\ndef history(days):\n    return w.rowsBetween(-(days - 1), 0)\np = (prices.withColumn(\"prior_close\", F.lag(\"close_price\").over(w))\n     .withColumn(\"ret\", F.when(F.col(\"prior_close\") > 0, F.col(\"close_price\")/F.col(\"prior_close\") - 1))\n     .withColumn(\"rng\", F.when(F.col(\"close_price\") > 0, (F.col(\"high_price\")-F.col(\"low_price\"))/F.col(\"close_price\")))\n     .withColumn(\"logvol\", F.when(F.col(\"volume\") >= 0, F.log1p(\"volume\"))))\np = (p.withColumn(\"volatility_5d\", F.stddev_samp(\"ret\").over(history(5)))\n     .withColumn(\"volatility_60d\", F.stddev_samp(\"ret\").over(history(60)))\n     .withColumn(\"abs_return_5d\", F.avg(F.abs(\"ret\")).over(history(5)))\n     .withColumn(\"range_5d\", F.avg(\"rng\").over(history(5)))\n     .withColumn(\"volume_z_20d\", F.when(F.stddev_samp(\"logvol\").over(history(20)) > 0,\n         (F.col(\"logvol\") - F.avg(\"logvol\").over(history(20))) / F.stddev_samp(\"logvol\").over(history(20)))))\nfor n in [10, 20, 60]:\n    lag_price = F.lag(\"close_price\", n).over(w)\n    p = p.withColumn(\"return_\" + str(n) + \"d\",\n         F.when(lag_price > 0, F.col(\"close_price\")/lag_price - 1))\np = (p.withColumn(\"vol_ratio_5_60\", F.when(F.col(\"volatility_60d\") > 0,\n           F.col(\"volatility_5d\")/F.col(\"volatility_60d\")))\n     .withColumn(\"price_to_ma20\", F.when(F.avg(\"close_price\").over(history(20)) > 0,\n           F.col(\"close_price\")/F.avg(\"close_price\").over(history(20)) - 1))\n     .withColumn(\"price_to_ma60\", F.when(F.avg(\"close_price\").over(history(60)) > 0,\n           F.col(\"close_price\")/F.avg(\"close_price\").over(history(60)) - 1))\n     .withColumn(\"price_in_range_20d\", F.when(\n           F.max(\"high_price\").over(history(20)) > F.min(\"low_price\").over(history(20)),\n           (F.col(\"close_price\")-F.min(\"low_price\").over(history(20))) /\n           (F.max(\"high_price\").over(history(20))-F.min(\"low_price\").over(history(20)))))\n     .withColumn(\"return_vs_vol20\", F.when(F.col(\"volatility_60d\") > 0,\n           F.col(\"return_20d\")/F.col(\"volatility_60d\"))))\n# First compute the market's daily average, then rolling summaries of PREVIOUS days.\nmarket = (p.groupBy(\"trade_date\")\n    .agg(F.avg(\"ret\").alias(\"market_return_1d\"),\n         F.avg(F.when(F.col(\"ret\").isNotNull(), (F.col(\"ret\") > 0).cast(\"double\"))).alias(\"market_breadth_1d\"),\n         F.avg(\"volatility_5d\").alias(\"market_volatility_5d\")))\nmw = Window.orderBy(\"trade_date\")\nmarket = (market.withColumn(\"market_avg_return_5d\", F.avg(\"market_return_1d\").over(mw.rowsBetween(-4, 0)))\n                .withColumn(\"market_avg_return_20d\", F.avg(\"market_return_1d\").over(mw.rowsBetween(-19, 0)))\n                .withColumn(\"market_breadth_5d\", F.avg(\"market_breadth_1d\").over(mw.rowsBetween(-4, 0))))\np = p.join(market, \"trade_date\", \"left\")\n# Compute the stock's own five-day return from cleaned prices, then subtract market trend.\nlag5 = F.lag(\"close_price\", 5).over(w)\np = (p.withColumn(\"stock_return_5d\", F.when(lag5 > 0, F.col(\"close_price\")/lag5 - 1))\n      .withColumn(\"relative_return_5d\", F.col(\"stock_return_5d\")-5*F.col(\"market_avg_return_5d\"))\n      .withColumn(\"relative_return_20d\", F.col(\"return_20d\")-20*F.col(\"market_avg_return_20d\")))\nextra_cols = list(dict.fromkeys(EXTRA_V1 + NEW_FEATURES))\nextra = p.select(\"ticker\", \"trade_date\", *extra_cols)\nfor c in extra_cols:\n    extra = extra.withColumn(c, F.when(F.isnan(c) | (F.abs(F.col(c)) == float(\"inf\")),\n                              F.lit(None).cast(\"double\")).otherwise(F.col(c)))\nfor split in SPLITS:\n    old = data[split]\n    joined = old.join(extra, [\"ticker\", \"trade_date\"], \"left\").cache()\n    assert joined.count() == old.count(), \"Join changed row count\"\n    data[split] = joined\n    old.unpersist()\nprint(\"Added\", len(extra_cols), \"historical features. V2 has\", len(FULL_FEATURES), \"total available features.\")\nprint(\"Missing training values (filled from TRAINING medians only):\")\ndata[\"training\"].select(*[F.sum(F.col(c).isNull().cast(\"int\")).alias(c) for c in extra_cols]).show(vertical=True)\n",
      "user": "anonymous",
