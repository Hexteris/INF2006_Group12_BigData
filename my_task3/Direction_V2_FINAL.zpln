      "title": "Reload proof",
      "text": "%spark.pyspark\n# Prove that saving/reloading keeps predictions the same.\nloaded = PipelineModel.load(MODEL_PATH)\nsample = data[\"testing\"].orderBy(\"ticker\", \"trade_date\").limit(5).cache()\ndef make_scores(model, df):\n    return (with_cutoff(model.transform(df)\n            .withColumn(\"risk_score\", vector_to_array(\"probability\")[1]), chosen_cutoff)\n            .select(\"ticker\", \"trade_date\", \"prediction\", \"risk_score\"))\na = make_scores(final_model, sample).orderBy(\"ticker\", \"trade_date\").collect()\nb = make_scores(loaded, sample).orderBy(\"ticker\", \"trade_date\").collect()\nassert len(a) == len(b) == 5\nfor x, y in zip(a, b):\n    assert x[\"ticker\"] == y[\"ticker\"] and x[\"trade_date\"] == y[\"trade_date\"]\n    assert x[\"prediction\"] == y[\"prediction\"]\n    assert abs(x[\"risk_score\"] - y[\"risk_score\"]) < 1e-9\nprint(\"RELOAD CHECK PASSED! Identical predictions and probabilities on five rows.\")\nmake_scores(loaded, sample).show(5, truncate=False)\nsample.unpersist()\n",
